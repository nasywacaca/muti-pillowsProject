<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    tools:context=".ProfileFragment">

    <!-- Header Toolbar Profile -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeaderProfile"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:cardBackgroundColor="#9E0B0F"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnHomeProfile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_home"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTitleProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil Developer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardHeaderProfile">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Kartu Profil Developer (100% ConstraintLayout) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfileData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/lblNama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Developer"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/valNama"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nasywa Mutiara Ramadhani"
                        android:textColor="#9E0B0F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblNama" />

                    <TextView
                        android:id="@+id/lblKampus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Kampus &amp; Jurusan"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valNama" />

                    <TextView
                        android:id="@+id/valKampus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Politeknik Caltex Riau - Teknik Informatika"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblKampus" />

                    <TextView
                        android:id="@+id/lblTtl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tempat &amp; Tanggal Lahir"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valKampus" />

                    <TextView
                        android:id="@+id/valTtl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pekanbaru, 01 Januari 2004"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblTtl" />

                    <TextView
                        android:id="@+id/lblEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Email"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valTtl" />

                    <TextView
                        android:id="@+id/valEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="nasywa24ti@mahasiswa.pcr.ac.id"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblEmail" />

                    <TextView
                        android:id="@+id/lblWa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="No. WhatsApp"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valEmail" />

                    <TextView
                        android:id="@+id/valWa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="+62 812-3456-7890"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblWa" />

                    <TextView
                        android:id="@+id/lblHobi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Hobi"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valWa" />

                    <TextView
                        android:id="@+id/valHobi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Scroll Tiktok"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblHobi" />

                    <TextView
                        android:id="@+id/lblKekuatan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Kekuatan Terbesar"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/valHobi" />

                    <TextView
                        android:id="@+id/valKekuatan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Slowliving"
                        android:textColor="#9E0B0F"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblKekuatan" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Judul Section SimpleAdapter -->
            <TextView
                android:id="@+id/tvOutletSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Informasi Outlet NIKI ECO 602"
                android:textColor="#9E0B0F"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardProfileData" />

            <!-- Card ListView dengan SimpleAdapter -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOutletList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOutletSection">

                <ListView
                    android:id="@+id/lvOutletInfo"
                    android:layout_width="match_parent"
                    android:layout_height="185dp"
                    android:divider="#F0E4D7"
                    android:dividerHeight="1dp"
                    android:nestedScrollingEnabled="true" />
            </androidx.cardview.widget.CardView>

            <!-- Tombol Hubungi Outlet -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallOutlet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="#9E0B0F"
                android:paddingVertical="12dp"
                android:text="HUBUNGI OUTLET"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardOutletList" />

            <!-- Tombol Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#9E0B0F"
                android:paddingVertical="12dp"
                android:text="LOGOUT"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnCallOutlet" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>